{
  "name": "hotelpos-desktop",
  "productName": "HotelPOS",
  "version": "1.1.0",
  "description": "HotelPOS - hotel point of sale (desktop)",
  "author": "Sam Squared Softwares",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.samsquared.hotelpos",
    "productName": "HotelPOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "ui/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HotelPOS"
    }
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
